{
  "name": "all-project-base",
  "version": "0.9.10",
  "date": "22.10.2026",
  "stack": "go",
  "commands": {
    "build": "go build -o bin/ ./...",
    "test": "go test ./...",
    "vet": "go vet ./...",
    "fmt": "gofmt -l .",
    "deadcode": "go run ./cmd/deadcode"
  },
  "required": [
    "README.md",
    "RULES.md",
    "AGENTS.md",
    "PROJECT.md",
    "FEATURE.md",
    "STRATEGY.md",
    "PROCESS.md",
    "JOURNAL.md",
    "CHANGELOG.md",
    "LICENSE",
    ".env.example",
    ".gitattributes",
    "go.mod",
    "verify.py",
    "project.json",
    "projects.example.json",
    "cmd/deadcode/main.go",
    "cmd/deadcode/main_test.go",
    "cmd/schemes/main.go",
    "cmd/schemes/main_test.go",
    "docs/scheme-rules.svg",
    "docs/scheme-strategy.svg",
    "docs/scheme-roadmap.svg",
    "docs/scheme-process.svg",
    "docs/scheme-isolation.svg",
    "docs/ISOLATION.md",
    "docs/acceptance/README.md",
    "deploy/systemd/proj@.service",
    "deploy/git/pre-receive",
    "deploy/bootstrap-project.sh",
    "deploy/selftest-isolation.sh",
    "deploy/logrotate/proj",
    "deploy/audit-drift.sh",
    "docs/adr/README.md",
    "docs/adr/0000-template.md",
    "docs/BRANCH_PROTECTION.md",
    "docs/DEPENDENCIES.md",
    "docs/PILOT.md",
    "docs/DEBT.md",
    "docs/LOGGING.md",
    "features/README.md",
    "features/0001-deadcode-json.md",
    "docs/RELEASE.md",
    "docs/BACKUP.md",
    "docs/MIGRATIONS.md",
    "docs/SECRETS.md",
    "tests/test_verify.py",
    "examples/minimal-go/README.md",
    "examples/minimal-go/go.mod",
    "examples/minimal-go/microblock.go",
    "examples/minimal-go/microblock_test.go"
  ],
  "rules_count": 10,
  "adr_min": 2,
  "forbid_npm": true,
  "ci": ["github"],
  "logs": {
    "test": "tests/test.log",
    "app": "var/log/app.log",
    "decisions": "JOURNAL.md",
    "max_bytes": 102400,
    "max_pages": 5
  },
  "project_sections": ["Назначение", "Стек", "Команды", "Границы", "Данные", "Окружения", "Исключения"],
  "feature_sections": ["Цель", "Схема плана", "Контракт", "Тесты", "Откат", "Готовность"],
  "isolation": {
    "projects_root": "/srv",
    "hooks_root": "/etc/git-hooks",
    "secrets_root": "/etc",
    "review_ref": "refs/heads/review",
    "main_ref": "refs/heads/main"
  },
  "schemes": {
    "docs/scheme-rules.svg": ["RULES.md"],
    "docs/scheme-strategy.svg": ["STRATEGY.md"],
    "docs/scheme-roadmap.svg": ["STRATEGY.md"],
    "docs/scheme-process.svg": ["PROCESS.md"],
    "docs/scheme-isolation.svg": ["docs/ISOLATION.md"]
  }
}
