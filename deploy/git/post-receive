#!/usr/bin/env bash
# Update the runtime checkout when a main push is received.
# Root normally uses update-ref (hooks do not run); deploy-project.sh is the
# explicit delivery step. This hook covers a push-based main update.
set -euo pipefail

PROJECT="$(basename "$(dirname "$0")")"
WORK="/srv/$PROJECT/current"
ZERO=0000000000000000000000000000000000000000

while read -r old new ref; do
  [ "$ref" = "refs/heads/main" ] || continue
  [ "$new" != "$ZERO" ] || continue
  [ -d "$WORK/.git" ] || continue
  git -C "$WORK" fetch origin main
  git -C "$WORK" checkout -B main FETCH_HEAD
  git -C "$WORK" reset --hard FETCH_HEAD
done
