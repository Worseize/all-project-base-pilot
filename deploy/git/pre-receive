#!/usr/bin/env bash
# Server-side gate. Installed at /etc/git-hooks/<proj>/pre-receive,
# root:root 0755. Accepts only refs/heads/review, rejects delete/force and
# changes to gate files, runs trusted verify.py from main.
set -euo pipefail
export PATH="/usr/local/go/bin:/usr/bin:/bin${PATH:+:$PATH}"
for candidate in /usr/lib/go/bin /opt/hostedtoolcache/go/*/x64/bin; do
  [ -d "$candidate" ] && PATH="$candidate:$PATH"
done
export PATH

ZERO=0000000000000000000000000000000000000000
PROJECT="$(basename "$(dirname "$0")")"
REPO="/srv/$PROJECT/repo.git"
LOG="/var/log/git/$PROJECT.log"
CURRENT_REF=""
CURRENT_OLD=""
CURRENT_NEW=""

log_event() {
  local result="$1" reason="$2" line
  line="$(date -Is) ref=$CURRENT_REF old=$CURRENT_OLD new=$CURRENT_NEW result=$result reason=$reason"
  printf '%s\n' "$line" >> "$LOG" 2>/dev/null ||
    logger -t "git-$PROJECT" "$line" 2>/dev/null || true
}

reject() {
  log_event reject "$*"
  printf 'review rejected: %s\n' "$*" >&2
  exit 1
}

git --git-dir="$REPO" rev-parse --verify --quiet refs/heads/main >/dev/null ||
  reject "main branch is missing; root must initialize it"

while read -r old new ref; do
  CURRENT_REF="$ref"
  CURRENT_OLD="$old"
  CURRENT_NEW="$new"

  [ "$ref" = "refs/heads/review" ] || reject "only refs/heads/review is allowed (got $ref)"
  [ "$new" != "$ZERO" ] || reject "deleting review is forbidden"

  if [ "$old" != "$ZERO" ]; then
    git --git-dir="$REPO" merge-base --is-ancestor "$old" "$new" ||
      reject "force push to review is forbidden"
  fi

  changed="$(git --git-dir="$REPO" diff --name-only refs/heads/main "$new" 2>/dev/null || true)"
  data_hits="$(printf '%s\n' "$changed" |
    grep -E '^(data/|.*/data/|\.env($|\.)|.*\.log$|var/lib/)' |
    grep -v '^\.env\.example$' || true)"
  [ -z "$data_hits" ] ||
    reject "state file in git: $(printf '%s' "$data_hits" | tr '\n' ' ')"
  protected_file="/etc/git-hooks/$PROJECT/protected-paths"
  if [ -f "$protected_file" ]; then
    while IFS= read -r path; do
      [ -n "$path" ] || continue
      while IFS= read -r pattern; do
        [ -n "$pattern" ] || continue
        case "$path" in
          "$pattern"*) reject "gate files changed: $path" ;;
        esac
      done < "$protected_file"
    done <<< "$changed"
  fi

  allowed_file="/etc/git-hooks/$PROJECT/allowed-paths"
  if [ -f "$allowed_file" ]; then
    while IFS= read -r path; do
      [ -n "$path" ] || continue
      allowed=0
      while IFS= read -r prefix; do
        [ -n "$prefix" ] || continue
        if [ "$prefix" = "*" ]; then
          allowed=1
          break
        fi
        case "$path" in
          "$prefix"*) allowed=1; break ;;
        esac
      done < "$allowed_file"
      [ "$allowed" -eq 1 ] || reject "path not allowed: $path"
    done <<< "$changed"
  fi

  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  git --git-dir="$REPO" archive "$new" | tar -x -C "$tmp"
  if git --git-dir="$REPO" cat-file -e refs/heads/main:project.conf 2>/dev/null; then
    manifest="$(git --git-dir="$REPO" show refs/heads/main:project.conf)"
    mget() {
      printf '%s\n' "$manifest" |
        awk -F= -v key="$1" '$1 == key { sub(/^[^=]*=/, ""); print; exit }'
    }
    run_path="$(mget run)"; run_path="${run_path#./}"; run_path="${run_path:-run}"
    health_path="$(mget health)"; health_path="${health_path#./}"; health_path="${health_path:-health}"
    test_cmd="$(mget test)"; test_cmd="${test_cmd:-test.sh}"
    for f in "$run_path" "$health_path"; do
      mode="$(git --git-dir="$REPO" ls-tree "$new" -- "$f" | awk '{print $1}')"
      [ "$mode" = "100755" ] || reject "$f mode ${mode:-missing}, expected 100755"
    done
    test_file="${test_cmd#./}"
    if git --git-dir="$REPO" cat-file -e "refs/heads/main:$test_file" 2>/dev/null; then
      git --git-dir="$REPO" show "refs/heads/main:$test_file" > "$tmp/.trusted-test.sh"
      if ! (cd "$tmp" && bash .trusted-test.sh); then
        reject "test failed for $new"
      fi
    elif ! (cd "$tmp" && bash -c "$test_cmd"); then
      reject "test command failed for $new: $test_cmd"
    fi
  elif git --git-dir="$REPO" cat-file -e refs/heads/main:test.sh 2>/dev/null; then
    for f in run test.sh health; do
      mode="$(git --git-dir="$REPO" ls-tree "$new" -- "$f" | awk '{print $1}')"
      [ "$mode" = "100755" ] || reject "$f mode ${mode:-missing}, expected 100755"
    done
    git --git-dir="$REPO" show refs/heads/main:test.sh > "$tmp/.trusted-test.sh"
    if ! (cd "$tmp" && bash .trusted-test.sh); then
      reject "test.sh failed for $new"
    fi
  elif git --git-dir="$REPO" cat-file -e refs/heads/main:verify.py 2>/dev/null; then
    git --git-dir="$REPO" show refs/heads/main:verify.py > "$tmp/.trusted-verify.py" ||
      reject "cannot load trusted verify.py from main"
    if ! (cd "$tmp" && python3 .trusted-verify.py); then
      reject "trusted verify.py failed for $new"
    fi
  else
    reject "no gate in main: test.sh or verify.py required"
  fi

  log_event accept "verified"
  rm -rf "$tmp"
  trap - EXIT
done

printf 'review accepted; root must merge to main\n'
