#!/usr/bin/env bash
# Server-side gate. Installed at /etc/git-hooks/<proj>/pre-receive,
# root:root 0755. Accepts only refs/heads/review, rejects delete/force and
# changes to gate files, runs trusted verify.py from main.
set -euo pipefail
export PATH="/usr/local/go/bin:/usr/bin:/bin${PATH:+:$PATH}"
for candidate in /usr/lib/go/bin /opt/hostedtoolcache/go/*/x64/bin; do
  [ -d "$candidate" ] && PATH="$candidate:$PATH"
done
export PATH

ZERO=0000000000000000000000000000000000000000
PROJECT="$(basename "$(dirname "$0")")"
REPO="/srv/$PROJECT/repo.git"
LOG="/var/log/git/$PROJECT.log"
CURRENT_REF=""
CURRENT_OLD=""
CURRENT_NEW=""

log_event() {
  local result="$1" reason="$2" line
  line="$(date -Is) ref=$CURRENT_REF old=$CURRENT_OLD new=$CURRENT_NEW result=$result reason=$reason"
  printf '%s\n' "$line" >> "$LOG" 2>/dev/null ||
    logger -t "git-$PROJECT" "$line" 2>/dev/null || true
}

reject() {
  log_event reject "$*"
  printf 'review rejected: %s\n' "$*" >&2
  exit 1
}

git --git-dir="$REPO" rev-parse --verify --quiet refs/heads/main >/dev/null ||
  reject "main branch is missing; root must initialize it"

while read -r old new ref; do
  CURRENT_REF="$ref"
  CURRENT_OLD="$old"
  CURRENT_NEW="$new"

  [ "$ref" = "refs/heads/review" ] || reject "only refs/heads/review is allowed (got $ref)"
  [ "$new" != "$ZERO" ] || reject "deleting review is forbidden"

  if [ "$old" != "$ZERO" ]; then
    git --git-dir="$REPO" merge-base --is-ancestor "$old" "$new" ||
      reject "force push to review is forbidden"
  fi

  changed="$(git --git-dir="$REPO" diff --name-only refs/heads/main "$new" 2>/dev/null || true)"
  protected="$(printf '%s\n' "$changed" |
    grep -E '^(verify\.py|project\.json|go\.mod|go\.sum|tests/|cmd/|deploy/|\.github/|\.gitlab-ci\.yml|azure-pipelines\.yml)' || true)"
  [ -z "$protected" ] ||
    reject "gate files changed: $(printf '%s' "$protected" | tr '\n' ' ')"

  allowed_file="/etc/git-hooks/$PROJECT/allowed-paths"
  [ -f "$allowed_file" ] || reject "allowlist missing: $allowed_file"
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    allowed=0
    while IFS= read -r prefix; do
      [ -n "$prefix" ] || continue
      case "$path" in
        "$prefix"*) allowed=1; break ;;
      esac
    done < "$allowed_file"
    [ "$allowed" -eq 1 ] || reject "path not allowed: $path"
  done <<< "$changed"

  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  git --git-dir="$REPO" archive "$new" | tar -x -C "$tmp"
  if [ -f "$tmp/test.sh" ]; then
    if ! (cd "$tmp" && bash test.sh); then
      reject "test.sh failed for $new"
    fi
  else
    git --git-dir="$REPO" show refs/heads/main:verify.py > "$tmp/.trusted-verify.py" ||
      reject "cannot load trusted verify.py from main"
    if ! (cd "$tmp" && python3 .trusted-verify.py); then
      reject "trusted verify.py failed for $new"
    fi
  fi

  log_event accept "verified"
  rm -rf "$tmp"
  trap - EXIT
done

printf 'review accepted; root must merge to main\n'
